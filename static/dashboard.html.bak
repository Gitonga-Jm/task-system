<!DOCTYPE html>
<html>
<head>
    <title>Task Queue Dashboard</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: Arial, sans-serif; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; padding: 20px; }
        .container { max-width: 1200px; margin: 0 auto; }
        h1 { color: white; margin-bottom: 30px; }
        .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 30px; }
        .stat-card { background: white; border-radius: 10px; padding: 20px; text-align: center; }
        .stat-number { font-size: 36px; font-weight: bold; color: #667eea; }
        .stat-label { color: #666; margin-top: 10px; }
        .card { background: white; border-radius: 10px; padding: 20px; margin-bottom: 20px; }
        .card h2 { margin-bottom: 20px; color: #333; }
        button { background: #667eea; color: white; border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer; margin: 5px; }
        button:hover { opacity: 0.8; }
        input, select, textarea { width: 100%; padding: 10px; margin: 10px 0; border: 1px solid #ddd; border-radius: 5px; }
        .task-item { border-left: 3px solid #667eea; padding: 10px; margin: 10px 0; background: #f9f9f9; }
        .error { color: red; }
        .success { color: green; }
    </style>
</head>
<body>
<div class="container">
    <h1>🚀 Task Queue Dashboard</h1>
    <div class="stats-grid">
        <div class="stat-card"><div class="stat-number" id="queueSize">-</div><div class="stat-label">Queue Size</div></div>
        <div class="stat-card"><div class="stat-number" id="deadLetterSize">-</div><div class="stat-label">Dead Letter Queue</div></div>
        <div class="stat-card"><div class="stat-number" id="tasksCreated">-</div><div class="stat-label">Tasks Created</div></div>
        <div class="stat-card"><div class="stat-number" id="tasksFailed">-</div><div class="stat-label">Tasks Failed</div></div>
    </div>
    <div class="card">
        <h2>Submit Task</h2>
        <select id="taskType">
            <option value="email">Email</option>
            <option value="fail_me">Test Failure</option>
        </select>
        <div id="emailFields">
            <input type="text" id="emailTo" placeholder="To email">
            <input type="text" id="emailSubject" placeholder="Subject">
            <textarea id="emailBody" placeholder="Body"></textarea>
        </div>
        <button onclick="submitTask()">Submit</button>
        <div id="result"></div>
    </div>
    <div class="card">
        <h2>Dead Letter Queue</h2>
        <button onclick="loadDeadLetters()">Refresh</button>
        <div id="deadLetters"></div>
    </div>
</div>
<script>
    function loadStats() {
        fetch('/stats').then(r=>r.json()).then(d=>{
            document.getElementById('queueSize').innerText = d.queue_size;
            document.getElementById('deadLetterSize').innerText = d.dead_letter_size;
            document.getElementById('tasksCreated').innerText = d.total_tasks_created;
            document.getElementById('tasksFailed').innerText = d.total_tasks_failed;
        });
    }
    function loadDeadLetters() {
        fetch('/dead-letter').then(r=>r.json()).then(d=>{
            let html = '';
            d.tasks.forEach(t=>{
                html += `<div class="task-item">
                    <strong>${t.type}</strong> - ${t.task_id}<br>
                    Error: ${t.last_error}<br>
                    <button onclick="retry('${t.task_id}')">Retry</button>
                    <button onclick="del('${t.task_id}')">Delete</button>
                </div>`;
            });
            document.getElementById('deadLetters').innerHTML = html || 'No dead letters';
        });
    }
    function submitTask() {
        let type = document.getElementById('taskType').value;
        let payload = {};
        if(type === 'email') {
            payload = {to: document.getElementById('emailTo').value, subject: document.getElementById('emailSubject').value, body: document.getElementById('emailBody').value};
        }
        fetch('/tasks', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({type,payload,max_retries:3})})
        .then(r=>r.json()).then(d=>{
            document.getElementById('result').innerHTML = `<span class="success">Task submitted: ${d.task_id}</span>`;
            loadStats();
            setTimeout(()=>document.getElementById('result').innerHTML='',3000);
        });
    }
    function retry(id) { fetch(`/dead-letter/retry/${id}`,{method:'POST'}).then(()=>{loadDeadLetters();loadStats();}); }
    function del(id) { fetch(`/dead-letter/${id}`,{method:'DELETE'}).then(()=>{loadDeadLetters();loadStats();}); }
    loadStats(); loadDeadLetters();
    setInterval(loadStats, 3000);
</script>
</body>
</html>
